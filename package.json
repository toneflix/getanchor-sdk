{
  "name": "getanchor-sdk",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "NodeJs SDK for Anchor API generated with oapiex from docs.getanchor.co.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "pnpm vitest --run",
    "test:watch": "pnpm vitest",
    "build": "tsdown",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@h3ravel/shared": "^2.2.7",
    "@oapiex/sdk-kit": "^0.1.16"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^25.8.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.6"
  }
}
